{
    "version": 3,
    "configurePresets": [
        {
            "name": "mac_debug",
            "description": "Mac debug",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_APPLOCAL_DEPS": "ON",
                "DEBUG_PRINT_ENABLED": "ON"
            }
        },
        {
            "name": "mac_arm_release",
            "description": "Mac arm release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_APPLOCAL_DEPS": "ON",
                "VCPKG_OSX_DEPLOYMENT_TARGET": "11.0",
                "DEBUG_PRINT_ENABLED": "OFF"
            }
        },
        {
            "name": "mac_intel_release",
            "description": "Mac intel release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-osx",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_APPLOCAL_DEPS": "ON",
                "VCPKG_OSX_DEPLOYMENT_TARGET": "10.15",
                "DEBUG_PRINT_ENABLED": "OFF"
            }
        },
        {
            "name": "windows_release",
            "description": "Windows x64 release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "VCPKG_APPLOCAL_DEPS": "OFF",
                "DEBUG_PRINT_ENABLED": "OFF"
            }
        }
    ]
}