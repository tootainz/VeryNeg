/*
GENERAL
------------------------------------------------------
*/

body {
    font-family: "Px437 SanyoMBC775-2y";
    width: 100%;
    height: 100%;
    color: #c1bfbc;
    font-size: 12dp;
    display: flex;
    justify-content: space-between;
    box-sizing: border-box;
    padding: 5dp;
}

p {
    display: block;
}

h2 {
    font-size: 14dp;
}

/*
INPUTS
--------
*/

/* Sliders */

input.range {
    height: 30dp;
    margin-top: 5dp;
    margin-bottom: 5dp;
    width: 100%;
}

input.range:hover {
    background-color: #00000012;
}

input.range slidertrack {
    background-color: #000000;
    height: 3dp;
    margin-top: 12.5dp;
}

input.range:active slidertrack {
    decorator: horizontal-gradient( #000000 #ffffff );
}

input.range sliderbar {
    background-color: #b3ada9;
    height: 12dp;
    width: 12dp;
    border-color: #00000000;
    border-width: 1dp;
    border-radius: 6dp;
    margin-top: 8dp;
}

input.range:active sliderbar {
    border-color: #e4ded7;
}


/* Text */

input.text {
    background-color: #161515;
    border: 1dp #161515;
    border-top: #0d0d0d;
    border-bottom: #2e2e2d;
}

input.text:hover {
    border-color: #8a8682;
}

input.text:active {
    background-color: #8a8682;
}

/* Checkbox */

input.checkbox {
    box-sizing: border-box;
    display: block;
    color: #353433;
    background-color: #161515;
    border: 1dp #161515;
    border-top: #0d0d0d;
    border-bottom: #2e2e2d;
    border-radius: 3dp;
    flex-grow: 1;
    padding: 5dp;
    margin-top: 5dp;
    margin-bottom: 5dp;
}

input.checkbox:checked {
    color: #ffffff;
    background-color: #52504e;
    border-top: #666461;
    border-bottom: #3e3d3c;
}
 
input.checkbox:hover {
    color: #8a8682;
    border-color: #8a8682;
    border-width: 1dp;
}

input.checkbox:active {
    background-color: #52504e;
}

.holdBox {
    color: #605e5c;
    background-color: #1e1d1d;
}

.holdBox:active {
    color: #000000;
    decorator: image( "./graphics/button2.png" fill );
}

.holdBox:checked {
    color: #000000;
    decorator: image( "./graphics/button1.png" fill );
}

input.checkbox.iconButton {
    overflow: hidden;
    height: 25dp;
    width: 25dp;
    padding: 2dp;
    margin: 5dp;
    flex-grow: 0;
    flex-shrink: 0;
}

input.checkbox.iconButton:checked {
    overflow: hidden;
    background-color: #161515;
    border: #ffffff;
}

/* Drop down */

select, option{
    background-color: #161515;
    border-radius: 3dp;
    padding: 5dp;
    margin: 5dp;
    border-color: rgba(255, 255, 255, 0);
    border-width: 1dp;
}

select:hover, option:hover {
    border-color: #8a8682;
}


/* Button */

button {
    box-sizing: border-box;
    display: block;
    color: #000000;
    background-color: #b3ada9;
    border-radius: 3dp;
    border: 1dp #b3ada9;
    border-top: #d4cfcb;
    border-bottom: #807e7c;
    padding: 5dp;
    margin: 5dp;
}

button:hover {
    background-color: #8e8986;
}

button:active {
    background-color: #8a8682;
}

.iconButton {
    overflow: hidden;
    height: 25dp;
    width: 25dp;
    padding: 2dp;
    margin: 5dp;
    flex-grow: 0;
    flex-shrink: 0;
}

/*
LAYOUT
------------------------------------------------------
*/

#left {
    height: 100%;
    width: 100%;
    min-width: 500dp;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

#right {
    width: 400dp;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
}

.horizontalFlex {
    display: flex;
    flex-direction: row;
}

.verticalFlex {
    display: flex;
    flex-direction: column;
}

.horizontalFlexBetween {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.verticalDivider {
    width: 1dp;
    height: 70dp;
    margin-right: 10dp;
    margin-left: 10dp;
    background-color: #171716;
    flex-shrink: 0;
}



/*
WELCOME
------------------------------------------------------
*/

#welcome {
    color: #000000;
    font-size: 16dp;
    padding: 20dp;
    width: 40%;
    height: 30%;
    background-color: #b6b1ad;
    border-radius: 3dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 35%;
    left: 30%;
    display: none;
}


/*
PREVIEW
------------------------------------------------------
*/

#preview {
    cursor: crosshair;
    background-color: #0e0e0e;
    height: 100%;
    margin: 20dp;
}

#releaseVersion {
    font-size: 20dp;
    color: #232222;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
}


/*
FILM ROLL
------------------------------------------------------
*/

#bottom {
    height: 80dp;
    display: flex;
    justify-content: space-between;
    background-color: #232221;
    border-color: #777370;
    border-width: 2dp;
    box-sizing: border-box;
    flex-shrink: 0;
}

#filmRoll {
    display: flex;
    gap: 5dp;
    height: 100%;
    width: 100%;
    align-items: center;
    overflow-x: auto;
}

scrollbarhorizontal {
	height: 0;
}

.thumbnail {
    width: 70dp;
    height: 70dp;
    border-width: 1dp;
    border-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;    
}

.thumbnail:hover {
    border-color: white;
    border-width: 1dp;
}

#bottom button {
    padding-top: 23dp;
    box-sizing: border-box;
    text-align: center;
    width: 20dp;
}

#previous {
    decorator: image( "./graphics/left.png" contain) content-box;
}

#next {
    decorator: image( "./graphics/right.png" contain) content-box;
}


/*
EXPORT-IMPORT-DELETE
------------------------------------------------------
*/

#importExport {
    margin-top: 5dp;
    box-sizing: border-box;
    height: 80dp;
    display: flex;
    background-color: #777370;
    flex-shrink: 0;
}

#importExport button {
    background-color: #b3ada9;
    color: #000000;
    width: 100%;
    box-sizing: border-box;
    padding-top: 28dp;
    text-align: center;
    margin: 5dp;
}

#importExport button:hover {
    background-color: #a09a96;
    color: #000000;
}


/*
SETTINGS
------------------------------------------------------
*/

.settingHeader {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #2d2c2b;
    border: 1dp #2d2c2b;
    border-top: #393836;
    border-bottom: #1f1e1d;
    border-radius: 3dp;
    padding-right: 5dp;
    padding-left: 5dp;
}

.settingContent {
    box-sizing: border-box;
    padding-right: 5dp;
    padding-left: 5dp;
}

.selectButtons {
    display: flex;
    width: 100%;
    gap: 5dp;
    margin-bottom: 5dp;
}

.settingsTab {
    position: relative;
    background-color: #232221;
    border: 1dp #232221;
    border-top: #2c2b2a;
    border-bottom: #171616;
    border-radius: 3dp;
    margin-bottom: 5dp;
}

#settings {
    gap: 0;
    width: auto;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: auto;
}

scrollbarvertical {
	width: 0;
}

.settingDivider {
    border-color: #363433;
    margin-top: 15dp;
    margin-bottom: 10dp;
    padding-bottom: 5dp;
    border-bottom-width: 3dp;
}

.resetButton {
    color: #605e5c;
    background-color: #333231;
    border: 1dp #333231;
    border-top: #464543;
    border-bottom: #242321;
}

/*
ORIENTATION AND CROP
--------
*/

#rotateClock {
    decorator: image( "./graphics/clock.png" contain) content-box;
}

#rotateCounterClock {
    decorator: image( "./graphics/counter_clock.png" contain) content-box;
}

#flipHorizontal {
    decorator: image( "./graphics/mirror_horiz.png" contain) content-box;
}

#flipVertical {
    decorator: image( "./graphics/mirror_vert.png" contain) content-box;
}

#setCrop {
    decorator: image( "./graphics/area.png" contain) content-box;
}



/*
PRE-CONVERT
--------
*/

#preConvertSettings {
    display: flex;
    flex-direction: column;
}

#convert {
    text-align: center;
    height: 40dp;
    font-size: 20dp;
    width: 100%;
    display: block;
    color: #ffffff;
    background-color: #353331;
    border: 0dp 0;
    border-radius: 3dp;
    padding: 10dp;
    margin: 0dp;
}

#convert:hover {
    color: #ffffff;
    background-color: #353331;
}

#convert:active {
    background-color: #464543;
}

#convertBG {
    transition: margin-top margin-bottom padding 0.2s;
    margin-top: 1dp;
    margin-bottom: 1dp;
    padding: 1dp;
    height: 40dp;
    width: 100%;
    border-radius: 3dp;
    decorator: image( "./graphics/convert_gradient.png" fill );
}

#convertBG:hover {
    margin-top: 0;
    margin-bottom: 0;
    padding: 2dp;
    height: 40dp;
    width: 100%;
    border-radius: 3dp;
    decorator: image( "./graphics/convert_gradient_hover.png" fill );
}

#sampleBorder {
    decorator: image( "./graphics/border.png" contain) content-box;
}

#sampleBorder:checked {
    decorator: 0;
}

#sampleDensest {
    decorator: image( "./graphics/densest.png" contain) content-box;
}

#sampleDensest:checked {
    decorator: 0;
}

#setScanArea {
    decorator: image( "./graphics/area.png" contain) content-box;
}

/*
POST-CONVERT
--------
*/

#postConvertSettings {
    display: flex;
    flex-direction: column;
}

input.range#c-r:active slidertrack {
    decorator: image( "./graphics/c_r_gradient.png" fill );
}

input.range#m-g:active slidertrack {
    decorator: image( "./graphics/m_g_gradient.png" fill );
}

input.range#y-b:active slidertrack {
    decorator: image( "./graphics/y_b_gradient.png" fill );
}


.cyan {
    color: #00ffff;
}

.magenta {
    color: #ff00ff;
}

.yellow {
    color: #ffff00;
}

#c-r sliderbar {
    background-color: #00d5ff;
}

#m-g sliderbar {
    background-color: #e600ff;
}

#y-b sliderbar {
    background-color: #ffdd00;
}

#sampleNeutral {
    decorator: image( "./graphics/color_balance.png" contain) content-box;
}

#sampleNeutral:checked {
    decorator: 0;
}


/*
SHARPEN
------------------------------------------------------
*/

#sharpeningContainer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 5dp;
    margin-bottom: 10dp;
}

#sharpeningPreview {
    background-color: #0e0e0e;
    width: 200dp;
    height: 200dp;
}

/*
EXPORT SETTINGS
------------------------------------------------------
*/

#exportSettings {
    flex-direction: column;
    position: absolute;
    top: 35%;
    margin: auto;
    padding: 15dp;
    color: #000000;
    background-color: #777370;
    width: 300dp;
    height: auto;
    z-index: 2;
    box-sizing: border-box;
    border-radius: 3dp;
}

#exportSettings.hidden {
    display: none;
}

#exportSettings select, #exportSettings option{
    color: white;
    background-color: #4d4a49;
    border-radius: 3dp;
    padding: 5dp;
    margin: 5dp;
    border-color: rgba(255, 255, 255, 0);
    border-width: 1dp;
}

#exportSettings select:hover, #exportSettings option:hover {
    border-color: #dcdcdc;
}

#exportSettings button {
    background-color: #b3ada9;
    color: #000000;
    box-sizing: border-box;
    padding-top: 24dp;
    padding-bottom: 24dp;
    text-align: center;
}

#exportSettings button:hover {
    background-color: #a09a96;
    color: #000000;
}