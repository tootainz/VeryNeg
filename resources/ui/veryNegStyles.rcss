/*
GENERAL
------------------------------------------------------
*/

body {
    font-family: "Oceert";
    width: 100%;
    height: 100%;
    font-size: 11px;
    display: flex;
    justify-content: space-between;
    box-sizing: border-box;
    padding: 5px;
}

p {
    display: block;
}

h2 {
    font-size: 14px;
}

/*
INPUTS
--------
*/

/* Sliders */

input.range {
    height: 30px;
    margin-top: 5px;
    margin-bottom: 5px;
}

input.range:hover {
    background-color: #00000012;
}

input.range slidertrack {
    background-color: #000000;
    height: 3px;
    margin-top: 12.5px;
}

input.range:active slidertrack {
    decorator: horizontal-gradient( #000000 #ffffff );
}

input.range sliderbar {
    background-color: #b3ada9;
    height: 12px;
    width: 12px;
    border-color: #00000000;
    border-width: 1px;
    border-radius: 6px;
    margin-top: 8px;
}

input.range:active sliderbar {
    border-color: #e4ded7;
}


/* Text */

input.text {
    background-color: #212020;
    border-color: #212020;
}

input.text:hover {
    border-color: #8a8682;
    border-width: 1px;
}

input.text:active {
    background-color: #8a8682;
}

/* Checkbox */

input.checkbox {
    box-sizing: border-box;
    display: block;
    background-color: #212020;
    border-color: #212020;
    border-width: 1px;
    border-radius: 3px;
    flex-grow: 1;
    padding: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
}

input.checkbox:checked {
    background-color: #52504e;
}
 
input.checkbox:hover {
    border-color: #8a8682;
    border-width: 1px;
}

input.checkbox:active {
    background-color: #52504e;
}

.holdBox:active {
    color: #000000;
    decorator: image( "./graphics/button2.png" fill );
}

.holdBox:checked {
    color: #000000;
    decorator: image( "./graphics/button1.png" fill );
}

/* Drop down */

select, option{
    background-color: #212020;
    border-radius: 3px;
    padding: 5px;
    margin: 5px;
    border-color: rgba(255, 255, 255, 0);
    border-width: 1px;
}

select:hover, option:hover {
    border-color: #8a8682;
}


/* Button */

button {
    box-sizing: border-box;
    display: block;
    color: #000000;
    background-color: #b3ada9;
    border-radius: 3px;
    padding: 5px;
    margin: 5px;
}

button:hover {
    background-color: #a09a96;
}

button:active {
    background-color: #8a8682;
}

input.checkbox.iconButton {
    overflow: hidden;
    height: 25px;
    width: 25px;
    margin: 5px;
    flex-grow: 0;
    flex-shrink: 0;
}

/*
LAYOUT
------------------------------------------------------
*/

#left {
    height: 100%;
    width: 100%;
    min-width: 500px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

#right {
    width: 400px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
}

.horizontalFlex {
    display: flex;
    flex-direction: row;
}

.verticalFlex {
    display: flex;
    flex-direction: column;
}

.horizontalFlexBetween {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.verticalDivider {
    width: 1.5px;
    height: 80px;
    margin-right: 5px;
    margin-left: 5px;
    background-color: #212121;
}



/*
WELCOME
------------------------------------------------------
*/

#welcome {
    color: #000000;
    font-size: 16px;
    padding: 20px;
    width: 40%;
    height: 30%;
    background-color: #b6b1ad;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 35%;
    left: 30%;
    display: none;
}


/*
PREVIEW
------------------------------------------------------
*/

#preview {
    cursor: crosshair;
    background-color: #0e0e0e;
    height: 100%;
    margin: 20px;
}

#releaseVersion {
    font-size: 20px;
    color: #232222;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
}


/*
FILM ROLL
------------------------------------------------------
*/

#bottom {
    height: 80px;
    display: flex;
    justify-content: space-between;
    background-color: #343332;
    border-color: #777370;
    border-width: 2px;
    box-sizing: border-box;
    flex-shrink: 0;
}

#filmRoll {
    display: flex;
    gap: 5px;
    height: 100%;
    width: 100%;
    align-items: center;
    overflow-x: auto;
}

scrollbarhorizontal {
	height: 0;
}

.thumbnail {
    width: 70px;
    height: 70px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;    
}

.thumbnail:hover {
    border-color: white;
    border-width: 1px;
}

#bottom button {
    padding-top: 23px;
    box-sizing: border-box;
    text-align: center;
    width: 20px;
}


/*
EXPORT-IMPORT-DELETE
------------------------------------------------------
*/

#importExport {
    margin-top: 5px;
    box-sizing: border-box;
    height: 80px;
    display: flex;
    background-color: #777370;
    flex-shrink: 0;
}

#importExport button {
    background-color: #b3ada9;
    color: #000000;
    width: 100%;
    box-sizing: border-box;
    padding-top: 28px;
    text-align: center;
    margin: 5px;
}

#importExport button:hover {
    background-color: #a09a96;
    color: #000000;
}


/*
SETTINGS
------------------------------------------------------
*/

.settingHeader {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #393836;
}

.selectButtons {
    display: flex;
    width: 100%;
    gap: 5px;
    margin-bottom: 5px;
}

.settingsTab {
    position: relative;
    background-color: #2d2c2b;
    border-radius: 3px;
    margin-bottom: 5px;
    padding: 10px;
}

#settings {
    gap: 0;
    width: auto;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: auto;
}

scrollbarvertical {
	width: 0;
}

.settingDivider {
    border-color: #363433;
    margin-top: 15px;
    margin-bottom: 10px;
    padding-bottom: 5px;
    border-bottom-width: 3px;
}


/*
PRE-CONVERT
--------
*/

#preConvertSettings {
    display: flex;
    flex-direction: column;
}

#convert {
    text-align: center;
    height: 40px;
    font-size: 20px;
    width: 100%;
    display: block;
    color: #ffffff;
    background-color: #292826;
    border-radius: 3px;
    padding: 10px;
    margin: 0px;
}

#convert:hover {
    color: #ffffff;
    background-color: #2b2a29;
}

#convert:active {
    background-color: #464543;
}

#convertBG {
    transition: margin-top margin-bottom padding 0.2s;
    margin-top: 1px;
    margin-bottom: 1px;
    padding: 1px;
    height: 40px;
    width: 100%;
    border-radius: 3px;
    decorator: image( "./graphics/convertGradientNotFull.png" fill );
}

#convertBG:hover {
    margin-top: 0;
    margin-bottom: 0;
    padding: 2px;
    height: 40px;
    width: 100%;
    border-radius: 3px;
    decorator: image( "./graphics/convertGradientFull.png" fill );
}

/*
POST-CONVERT
--------
*/

#postConvertSettings {
    display: flex;
    flex-direction: column;
}

input.range#c-r:active slidertrack {
    decorator: horizontal-gradient( #00ffff #ff0000 );
}

input.range#m-g:active slidertrack {
    decorator: horizontal-gradient( #ff00ff #00ff00 );
}

input.range#y-b:active slidertrack {
    decorator: horizontal-gradient( #ffff00 #0000ff );
}


.cyan {
    color: #00ffff;
}

.magenta {
    color: #ff00ff;
}

.yellow {
    color: #ffff00;
}

#c-r sliderbar {
    background-color: #00d5ff;
}

#m-g sliderbar {
    background-color: #e600ff;
}

#y-b sliderbar {
    background-color: #ffdd00;
}


/*
SHARPEN
------------------------------------------------------
*/

#sharpeningContainer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 5px;
    margin-bottom: 10px;
}

#sharpeningPreview {
    background-color: #0e0e0e;
    width: 200px;
    height: 200px;
}

/*
EXPORT SETTINGS
------------------------------------------------------
*/

#exportSettings {
    flex-direction: column;
    position: absolute;
    top: 50%;
    left: 80%;
    padding: 5px;
    color: #000000;
    background-color: #777370;
    width: 300px;
    height: auto;
    z-index: 2;
    box-sizing: border-box;
}

#exportSettings.hidden {
    display: none;
}


#exportSettings button {
    background-color: #b3ada9;
    color: #000000;
    box-sizing: border-box;
    padding-top: 28px;
    text-align: center;
}

#exportSettings button:hover {
    background-color: #a09a96;
    color: #000000;
}