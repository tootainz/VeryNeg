body {
    font-family: "Oceert";
    width: 100%;
    height: 100%;
    font-size: 11px;
    display: flex;
    justify-content: space-between;
    box-sizing: border-box;
}

p {
    display: block;
}

h2 {
    font-size: 14px;
}

#convert {
    height: 40px;
    font-size: 20px;
    width: 100%;
}

input.range {
    height: 20px;
    padding: 5px;
    margin: 5px;
}

input.range slidertrack {
    background-color: #000000;
    margin-top: 7px;
    height: 5px;
}

input.range sliderbar {
    background-color: #52504e;
    height: 20px;
    width: 20px;
    border-radius: 10px;
}

input.checkbox {
    display: block;
    background-color: #52504e;
    border-radius: 3px;
    padding: 5px;
    margin: 5px;
}

input:checked {
    background-color: #8a8682;
}

input:hover {
    background-color: #393837;
}

input:active {
    background-color: #8a8682;
}

select {
    background-color: #52504e;
    border-radius: 3x;
    padding: 5px;
    margin: 5px;
}

option {
    background-color: #52504e;
    border-radius: 3px;
    padding: 5px;
    margin: 5px;
}

button {
    display: block;
    background-color: #52504e;
    border-radius: 3px;
    padding: 5px;
    margin: 5px;
}

.settingHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.selectButtons {
    display: flex;
    width: 100%;
}

.selectButtons input.checkbox {
    flex: 1;
}

.selectButtons .targetButton {
    min-width: 10px;
    min-height: 10px;
    flex-shrink: 0;
}

button:hover {
    background-color: #393837;
}

button:active {
    background-color: #8a8682;
}

#left {
    /* background-color: #ff80002a; */
    height: 100%;
    width: 100%;
    min-width: 500px;
    display: flex;
    flex-direction: column;
}

#welcome {
    color: #000000;
    font-size: 16px;
    padding: 20px;
    width: 40%;
    height: 30%;
    background-color: #b6b1ad;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 35%;
    left: 30%;
    display: none;
}

#preview {
    cursor: crosshair;
    background-color: #0e0e0e;
    height: 100%;
    margin: 20px;
}

#releaseVersion {
    font-size: 20px;
    color: #232222;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
}

#bottom {
    height: 100px;
    display: flex;
    justify-content: space-between;
    background-color: #343332;
    margin: 5px;
    margin-right: 0;
    border-color: #b6b1ad;
    border-width: 2px;
}

#filmRoll {
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
}

.thumbnail {
    width: 80px;
    height: 80px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;    
}

.thumbnail:hover {
    border-color: white;
    border-width: 1px;
}

#right {
    width: 400px;
    height: 100%;
    margin: 5px;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.settingsTab {
    background-color: #343332;
    border-radius: 3px;
    margin-bottom: 5px;
    padding: 10px;
}

#settings {
    gap: 0;
    width: auto;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: auto;
}

scrollbarvertical {
	width: 0;
}

#exportSettings {
    height: 100px;
    display: flex;
    background-color: #b6b1ad;
    flex-shrink: 0;
}

#preConvertSettings {
    display: flex;
    flex-direction: column;
}

#postConvertSettings {
    display: flex;
    flex-direction: column;
}

#c-r sliderbar {
    background-color: #00d5ff;
}

#m-g sliderbar {
    background-color: #e600ff;
}

#y-b sliderbar {
    background-color: #ffdd00;
}

#sharpenPreview {
    background-color: #0e0e0e;
    width: 200px;
    height: 200px;
}
