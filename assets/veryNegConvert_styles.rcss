body {
    font-family: "Oceert";
    width: 100%;
    height: 100%;
    font-size: 12px;
    display: flex;
    justify-content: space-between;
}

p {
    display: block;
}

input.range
{
    height: 20px;
    padding: 5px;
    margin: 5px;
}

input.range slidertrack
{
    background-color: #000000;
    height: 5px;
}

input.range sliderbar
{
    background-color: #52504e;
    height: 20px;
    width: 10px;
}

button {
    display: block;
    background-color: #52504e;
    border-radius: 10px;
    padding: 5px;
    margin: 5px;
}

button:hover {
    background-color: #393837;
}

button:active {
    background-color: #8a8682;
}

#left {
    /* background-color: #ff80002a; */
    height: 100%;
    width: 100%;
    min-width: 500px;
    display: flex;
    flex-direction: column;
}

#preview {
    background-color: #0e0e0e;
    height: 100%;
    margin: 20px;
}

#releaseVersion {
    font-size: 20px;
    color: #232222;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
}

#filmRoll {
    background-color: #343332;
    margin: 5px;
    display: flex;
    height: 100px;
    padding: 5px;
    align-items: center;
}

.thumbnail {
    width: 80px;
    height: 80px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;    
}

.thumbnail:hover {
    border-color: white;
    border-width: 1px;
}

#settings {
    background-color: #343332;
    width: 400px;
    display: flex;
    flex-direction: column;
    padding: 5px;
    margin: 5px;
    margin-left: 0;
}

#preConvertSettings {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

#postConvertSettings {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

#exportSettings {
    background-color: #b6b1ad;
}

#c-r sliderbar {
    background-color: #00d5ff;
}

#m-g sliderbar {
    background-color: #e600ff;
}

#y-b sliderbar {
    background-color: #ffdd00;
}