body {
    font-family: "Oceert";
    width: 100%;
    height: 100%;
    font-size: 16px;
    display: flex;
    justify-content: flex-end;
}

input.range
{
    height: 20px;
    padding: 5px;
    margin: 5px;
}

input.range slidertrack
{
    background-color: #000000;
    height: 5px;
}

input.range sliderbar
{
    background-color: #6600ff;
    height: 20px;
    width: 10px;
}

button {
    display: block;
    background-color: #6600ff;
    border-radius: 10px;
    padding: 5px;
    margin: 5px;
}

button:hover {
    background-color: #4500ac;
}

button:active {
    background-color: #a061ff;
}

#settings {
    background-color: #1e1c20;
    width: 400px;
    display: flex;
    flex-direction: column;
    padding: 5px;
    margin: 5px;
}

#preConvertSettings {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

#postConvertSettings {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

#exportSettings {
    background-color: #c3bdc9;
}

#c-r sliderbar {
    background-color: #00d5ff;
}

#m-g sliderbar {
    background-color: #e600ff;
}

#y-b sliderbar {
    background-color: #ffdd00;
}